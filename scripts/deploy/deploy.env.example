# 将本文件复制为项目根目录下的 .forgedesk/deploy.env。
# .forgedesk/ 已被 Git 忽略，因此服务器地址和私钥路径不会被提交。
# cp scripts/deploy/deploy.env.example .forgedesk/deploy.env

# 必填：服务器公网 IP 或域名、SSH 登录用户、开发机上的 SSH 私钥绝对路径。
FORGEDESK_DEPLOY_HOST=203.0.113.10
FORGEDESK_DEPLOY_USER=ubuntu
FORGEDESK_DEPLOY_SSH_KEY=/absolute/path/to/server.pem

# 可选：以下默认值匹配当前 1Panel OpenResty + java21 容器部署。
# 只有服务器目录或容器名与默认值不一致时才修改。
# OpenResty 前端静态目录。
FORGEDESK_DEPLOY_WEB_ROOT=/opt/1panel/apps/openresty/openresty/root/forgedesk
# Java 容器读取的后端 JAR 路径。
FORGEDESK_DEPLOY_BACKEND_JAR=/www/forgedesk-backend.jar
# Java 后端容器名。
FORGEDESK_DEPLOY_BACKEND_CONTAINER=java21
# 服务器内部健康检查地址，不对公网开放。
FORGEDESK_DEPLOY_HEALTH_URL=http://127.0.0.1:8080/actuator/health
# 可选：服务器保存已上传压缩包的普通用户目录。
# FORGEDESK_DEPLOY_RELEASE_DIR=/home/ubuntu/.forgedesk/releases
