# 将此文件复制到 ~/.forgedesk/dev.env 后按个人偏好修改。
# 该本地文件不会进入 Git。

# 1：前端开发启动时同步拉起并等待后端健康检查；0：只启动前端。
FORGEDESK_START_BACKEND=0
# 对外暴露后端时，必须同时设置管理员初始化口令。
# FORGEDESK_BIND_ADDRESS=0.0.0.0
# FORGEDESK_ADMIN_BOOTSTRAP_TOKEN=change-this-before-starting

# 逗号分隔的浏览器来源。部署到公网 IP 时例如：
# FORGEDESK_ALLOWED_ORIGINS=http://203.0.113.10

# 服务端状态使用 MySQL 与 Redis。开发环境可连接本机 Docker 服务：
# FORGEDESK_DB_URL=jdbc:mysql://127.0.0.1:3306/forgedesk?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# FORGEDESK_DB_USERNAME=forgedesk
# FORGEDESK_DB_PASSWORD=change-this
# FORGEDESK_REDIS_HOST=127.0.0.1
# FORGEDESK_REDIS_PORT=6379
# FORGEDESK_REDIS_PASSWORD=change-this

# ForgeDesk 后端以 JDK 21 编译。未设置时会自动优先使用机器上的 JDK 21。
# FORGEDESK_JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home
